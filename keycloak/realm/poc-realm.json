{
  "realm": "poc",
  "enabled": true,
  "displayName": "Email 2FA PoC",
  "loginTheme": "poc-main",
  "accountTheme": "poc-account",
  "registrationAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging", "poc-audit"],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@poc.local",
    "fromDisplayName": "Email 2FA PoC",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "clients": [
    {
      "clientId": "poc-app",
      "name": "PoC App",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "poc-app-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8000/oauth2/callback"],
      "webOrigins": ["http://localhost:8000"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8000/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"],
      "protocolMappers": [
        {
          "name": "email verified at",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email_verified_at",
            "claim.name": "email_verified_at",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "external idp linked",
          "protocol": "openid-connect",
          "protocolMapper": "poc-external-idp-linked-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "external idp linked at",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "external_idp_linked_at",
            "claim.name": "external_idp_linked_at",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "login provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "login_provider",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "mfa method",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "mfa_method",
            "claim.name": "mfa_method",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.com",
      "emailVerified": false,
      "realmRoles": ["default-roles-poc"],
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo1234",
          "temporary": false
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50
    }
  ],
  "authenticationFlows": [
    {
      "alias": "poc-phase1-browser",
      "description": "PoC Phase 1 browser flow. Independent copy-style flow; built-in browser is not modified.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "poc-phase1-forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "poc-phase1-forms",
      "description": "Phase 1 username/password forms without email OTP.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "poc-phase2-browser",
      "description": "PoC Phase 2 browser flow. Independent flow with password plus email OTP for local login.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "poc-phase2-forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "poc-phase2-forms",
      "description": "Phase 2 local login: password then email OTP.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "email-authenticator",
          "authenticatorConfig": "poc-email-otp",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "poc-external-idp-post-login-phase2",
      "description": "Phase 2 post-broker flow: enforce the same Email OTP after external IdP authentication.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "poc-mfa-method-selector",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "email-authenticator",
          "authenticatorConfig": "poc-email-otp",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "poc-email-otp",
      "config": {
        "skipSetup": "true"
      }
    }
  ],
  "browserFlow": "poc-phase1-browser"
}
